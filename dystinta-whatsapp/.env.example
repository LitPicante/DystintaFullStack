# =============================================================================
# Dystinta WhatsApp - Evolution API privado/local
# Copiar este archivo como ".env" antes de ejecutar:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Imagen oficial de Evolution API
# -----------------------------------------------------------------------------
# latest sirve para pruebas rapidas. Para produccion se recomienda fijar version.
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest

# -----------------------------------------------------------------------------
# Red local privada
# -----------------------------------------------------------------------------
# Evolution API se publica SOLO en localhost del VPS/equipo.
# No cambiar EVOLUTION_BIND_HOST a 0.0.0.0 si queres mantenerlo privado.
EVOLUTION_BIND_HOST=127.0.0.1
EVOLUTION_PORT=8080
SERVER_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Seguridad de API
# -----------------------------------------------------------------------------
# Cambiar en produccion por una clave larga generada con:
#   openssl rand -hex 32
AUTHENTICATION_API_KEY=dystinta-local-change-this-64-char-secret-key-2026

# -----------------------------------------------------------------------------
# Sesion WhatsApp
# -----------------------------------------------------------------------------
# Nombre descriptivo del cliente/dispositivo que aparecera al vincular WhatsApp.
CONFIG_SESSION_PHONE_CLIENT=Dystinta WhatsApp

# -----------------------------------------------------------------------------
# Base de datos interna para Evolution API
# -----------------------------------------------------------------------------
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=dystinta-whatsapp
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=dystinta-postgres-change-this-password-2026
DATABASE_CONNECTION_URI=postgresql://evolution:dystinta-postgres-change-this-password-2026@postgres:5432/evolution?schema=public

# Guardado de datos utiles para sesiones, mensajes, contactos y chats.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# -----------------------------------------------------------------------------
# Redis interno
# -----------------------------------------------------------------------------
# Redis NO se expone en puertos publicos. Solo existe dentro de la red Docker.
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0
CACHE_REDIS_PREFIX_KEY=dystinta
CACHE_LOCAL_ENABLED=false

# -----------------------------------------------------------------------------
# Webhooks internos hacia Django
# -----------------------------------------------------------------------------
# En VPS Linux, desde el contenedor se llega al host con host.docker.internal
# gracias a extra_hosts en docker-compose.yml.
# Cuando Django tenga el endpoint real, mantenerlo interno:
#   http://host.docker.internal:8000/api/whatsapp/webhook/
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://host.docker.internal:8000/api/whatsapp/webhook/
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=true

# -----------------------------------------------------------------------------
# WebSocket
# -----------------------------------------------------------------------------
# Desactivado porque el flujo objetivo es Django <-> HTTP interno.
WEBSOCKET_ENABLED=false

# -----------------------------------------------------------------------------
# CORS defensivo
# -----------------------------------------------------------------------------
# Aunque Evolution API no sera publico, dejamos origenes locales conocidos.
CORS_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Puertos internos documentados
# -----------------------------------------------------------------------------
# Estos valores son informativos/operativos para mantener claro el mapa.
EVOLUTION_INTERNAL_PORT=8080
DJANGO_INTERNAL_URL=http://127.0.0.1:8000
DJANGO_WEBHOOK_FROM_CONTAINER=http://host.docker.internal:8000/api/whatsapp/webhook/

# -----------------------------------------------------------------------------
# Timezone y logs
# -----------------------------------------------------------------------------
TZ=America/Asuncion
LOG_LEVEL=INFO
